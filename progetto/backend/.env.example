# =============================================================================
# Pipeline didattica — variabili d'ambiente
# Copia questo file in .env e compila i valori:
#   cp .env.example .env
# Il file .env non va committato (è in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — provider (obbligatorio almeno una API key)
# -----------------------------------------------------------------------------
# Provider esplicito: openrouter | groq
# Se omesso: usa Groq solo se c'è GROQ_API_KEY e non OPENROUTER_API_KEY, altrimenti OpenRouter.
# LLM_PROVIDER=openrouter

# --- OpenRouter (consigliato per structured output / modelli vari) ---
OPENROUTER_API_KEY=
# Modello chat (es. deepseek/deepseek-v4-flash, meta-llama/llama-3.1-8b-instruct)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Prezzi USD per 1M token (solo per stima costi nei log se l'API non li restituisce)
OPENROUTER_INPUT_PRICE_PER_M=0.05
OPENROUTER_OUTPUT_PRICE_PER_M=0.08

# Embedding per fusione semantica del piano corpus multi-libro (OpenRouter /v1/embeddings)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Similarità minima (coseno) per accoppiare segmenti di libri diversi nello stesso punto_taglio
CORPUS_EMBEDDING_MIN_SIMILARITY=0.28
# Caratteri di estratto markdown inclusi nel testo da embeddare (oltre titolo e concetti)
CORPUS_EMBEDDING_SNIPPET_CHARS=1000
# Testi per richiesta batch all'API embeddings
CORPUS_EMBEDDING_BATCH_SIZE=48

# --- Groq (alternativa; rate limiter integrato) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MAX_TOKENS=1024
# Richieste al secondo (0.5 ≈ 30 RPM sul tier free)
# GROQ_REQUESTS_PER_SECOND=0.5
# GROQ_RATE_LIMITER_MAX_BUCKET=1
# GROQ_INPUT_PRICE_PER_M=
# GROQ_OUTPUT_PRICE_PER_M=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Livello root: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 1 / true / yes = log tecnici httpx/OpenAI/LangChain oltre ai messaggi narrativi
# LOG_VERBOSE=0

# -----------------------------------------------------------------------------
# Document Agent — conversione e sintesi parallele
# -----------------------------------------------------------------------------
# OpenRouter: lasciare VUOTO o "max" = tutte le analisi IA in parallelo (consigliato).
# Groq: default 12 (rate limit); oppure GROQ_LLM_MAX_WORKERS=8
# LLM_MAX_WORKERS=
# GROQ_LLM_MAX_WORKERS=12

# -----------------------------------------------------------------------------
# Planning Agent — piano strutturale e punti di taglio
# -----------------------------------------------------------------------------
# Minimo parole per considerare una sezione come modulo (evita titoli vuoti)
PLANNING_MIN_WORDS=80

# Fusione corpus multi-libro: embedding OpenRouter (vedi anche OPENROUTER_EMBEDDING_MODEL sopra)
# CORPUS_EMBEDDING_MIN_SIMILARITY=0.28
# CORPUS_EMBEDDING_SNIPPET_CHARS=1000
# CORPUS_EMBEDDING_BATCH_SIZE=48

# -----------------------------------------------------------------------------
# Validation Agent — controllo moduli grezzi
# -----------------------------------------------------------------------------
# off = solo regole locali (veloce, default)
# flagged = LLM solo sui moduli già dubbi
# all = LLM su ogni modulo (lento, molte chiamate API)
VALIDATION_USE_LLM=off

# -----------------------------------------------------------------------------
# Microlearning Agent — corso finale (lezioni + quiz)
# -----------------------------------------------------------------------------
# Passi massimi del Deep Agent (esplorazione + tool)
# Se impostato, sovrascrive il calcolo adattivo. Lasciare commentato per auto-scaling dal piano.
# MICROLEARNING_MAX_STEPS=120
# MICROLEARNING_MAX_STEPS_DEFAULT=120
# MICROLEARNING_MAX_STEPS_CAP=400
# MICROLEARNING_STEPS_PER_LESSON=5
# Round di ripresa se il corso non è ancora completo (carica JSON esistente)
MICROLEARNING_MAX_ROUNDS=8
MICROLEARNING_CONTINUATION_STEPS=80
# Obiettivo corso: scala dal piano strutturale (punti_taglio in reports/*_plan.json)
# MICROLEARNING_TARGET_MIN_LESSONS=15
# MICROLEARNING_TARGET_MAX_LESSONS=40
# MICROLEARNING_TARGET_LESSONS_CAP=120
# MICROLEARNING_PLAN_COVERAGE_MIN=0.5
# MICROLEARNING_PLAN_COVERAGE=0.85
# MICROLEARNING_TARGET_THRESHOLD=0.9
# MICROLEARNING_TARGET_MIN_QUIZ=3
# Libreria globale agente (script/note riusabili su tutti i corsi)
# Default: progetto/backend/agent_shared/
# MICROLEARNING_AGENT_SHARED_ROOT=/path/custom
# 0 = disabilita execute (solo markdown in .agent); 1 = script eseguibili
MICROLEARNING_AGENT_EXECUTE=1
# Timeout secondi per comandi execute nella home agente
# MICROLEARNING_EXECUTE_TIMEOUT=90
# Caratteri minimi del campo contenuto per ogni lezione
MICRO_MIN_CONTENUTO_CHARS=500
# Domande minime per ogni quiz
MICRO_MIN_QUIZ_DOMANDE=3
# Sezioni ## minime per lezione (Introduzione, Concetti, Riepilogo, ecc.)
MICRO_MIN_H2_SECTIONS=3
# Percorso assoluto o relativo al workspace del JSON corso (default: reports/microlearning_course.json)
# MICROLEARNING_COURSE_PATH=reports/microlearning_course.json
# Solo per esecuzione diretta: python -m agents.microlearning_agent
# MICROLEARNING_WORKSPACE=workspace/think_python
